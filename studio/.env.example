# Copy to `studio/.env` and fill in. `.env` is gitignored; this template is not.
# Tokens: https://sanity.io/manage/project/6gnkakot/api#tokens

# Used by the Sanity CLI — dataset import/export, `schema deploy`, `deploy`.
#
# The "Add API token" dialog lets you tick more than one role, and this token
# needs two:
#
#   Editor                      read/write the dataset — import, export, documents
#   Deploy Studio (Token only)  under "Other roles" — `sanity deploy` and
#                               `schema deploy`
#
# There is no "Administrator" option in that dialog. An Editor-only token is
# refused with "missing one of the grants sanity.project/deployStudio,
# sanity.project/deploySchema".
SANITY_AUTH_TOKEN=

# Which dataset this Studio edits. Empty means the one in project.jsonc.
#
# PUT A STAGING SWITCH IN `studio/.env.development`, NOT HERE AND NOT IN
# `.env.local` — ".local" means "gitignored", not "development only", so a
# value there is compiled into `npm run studio:deploy` and ships to the hosted
# Studio. `.env.development` is loaded by `sanity dev` and never by a build.
#
# `npm run studio:deploy` also refuses to run if this resolves to anything but
# production, as a backstop.
#
# The SANITY_STUDIO_ prefix is mandatory; Sanity exposes nothing else to Studio
# code.
SANITY_STUDIO_DATASET=

# Optional cross-check: if set, the deploy guard refuses to run when it does
# not match project.jsonc's sanity.projectId. Leave empty unless you want that
# belt-and-braces.
SANITY_STUDIO_PROJECT_ID=
