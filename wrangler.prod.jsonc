{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site-navi",
	"account_id": "9095ee3415dc7ee4e497da2a3c8d1992",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat"],

	// PRODUCTION — what answers on the live domain, and the only config anything
	// ever deploys from:
	//   npm run deploy
	// wrangler.jsonc is the same Worker minus the route, and exists purely so
	// `wrangler dev` has a local config. Deploy always means production.

	// The adapter's GENERATED server entry. Not
	// `@astrojs/cloudflare/entrypoints/server` — that module exports
	// `createExports(manifest)` and has no fetch handler, so deploying it yields
	// a Worker that answers nothing. Keep this in step with what
	// `web/dist/server/wrangler.json` reports after a build.
	"main": "./web/dist/server/entry.mjs",

	// BOTH ROUTES ARE COMMENTED OUT, DELIBERATELY.
	//
	// Attaching a custom domain takes the hostname over from whatever serves it
	// today, so uncommenting the second line IS the cut-over from Webflow — the
	// public site moves the moment the deploy succeeds. Neither line goes live
	// without the PM saying so for that specific deploy.
	"routes": [],
	// "routes": [{ "pattern": "navi.sygnal.cloud", "custom_domain": true }],
	// "routes": [{ "pattern": "www.tournewzealand.com", "custom_domain": true }],

	// True while the custom domains are still commented out, so staging builds
	// are reachable for review. Set to false at cut-over so there is no second
	// indexable copy of every page.
	"workers_dev": true,

	// NO `not_found_handling`, DELIBERATELY — and this is the setting that is
	// silently wrong either way, so the reasoning is written down.
	//
	// Every route on this site renders ON DEMAND, because a publish in the
	// Studio has to be live immediately and even the shared nav carries Sanity
	// collection lists. `"404-page"` is answered by the ASSET LAYER BEFORE the
	// Worker runs, and an on-demand route is by definition a path with no
	// matching file — so setting it would intercept every page the Worker exists
	// to render and serve the 404 instead.
	//
	// The 404 for an unknown path is returned by the Worker itself, from
	// `src/pages/[...slug].astro`.
	//
	// If this site ever goes back to prerendering, `"404-page"` becomes REQUIRED
	// rather than merely allowed: an unmatched path would then never reach the
	// Worker, and Cloudflare would answer with its own bare 404.
	"assets": {
		"directory": "./web/dist/client",
		"binding": "ASSETS"
	},

	// Declared by the adapter in web/dist/server/wrangler.json. An assets-only
	// deploy did not need these; a Worker does.
	"kv_namespaces": [{"binding": "SESSION"}],
	"images": {"binding": "IMAGES"},

	"observability": {
		"enabled": true
	}
}
