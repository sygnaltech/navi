# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# This is the REPO-ROOT env file: the site (web/) reads it too, because
# `web/astro.config.mjs` sets `vite.envDir: '..'` so SANITY_DATASET means one
# thing to the build and to the migration scripts alike.
#
# The Studio has its own: see `studio/.env.example`.
#
# Every non-secret value lives in `project.jsonc` instead.

# ── Needed to run the migration ────────────────────────────────────────────

# Webflow Site API token, CMS read scope — Webflow site settings > Apps &
# integrations > API access. Used by `npm run wf:pull` to dump the collections
# verbatim. Not needed by the build, and not needed at all once the content is
# in Sanity.
WEBFLOW_API_TOKEN=

# Sanity token with write access to the project in project.jsonc —
# https://sanity.io/manage/project/6gnkakot/api#tokens. Used by
# `npm run sanity:import`.
SANITY_AUTH_TOKEN=

# ── Optional, for the site build ───────────────────────────────────────────

# Which Sanity dataset the SITE reads. Empty means the one in project.jsonc.
#
# PUT A STAGING SWITCH IN `.env.development`, NOT HERE AND NOT IN `.env.local`:
#
#   .env.development   loaded by `npm run dev` only — never by a build
#   .env / .env.local  loaded in ALL cases, builds included
#
# ".local" means "gitignored", not "development only" — an easy and expensive
# thing to assume. Astro inlines `import.meta.env` at build time rather than
# reading it per request, so a staging value in `.env` or `.env.local` is
# compiled into `npm run build` output and ships to the live site.
#
# `npm run deploy` also refuses to run if this resolves to anything but
# production (migration-scripts/guard-production-deploy.mjs), as a backstop.
#
# No PUBLIC_ prefix on purpose: only server code imports the Sanity client, and
# the dataset name does not belong in a browser bundle.
SANITY_DATASET=

# Read-only. NOT needed while the production dataset is publicly readable, which
# it is. Required only for reading drafts (preview).
SANITY_READ_TOKEN=

# Optional cross-check: if set, the deploy guard refuses to run when it does not
# match project.jsonc's sanity.projectId.
SANITY_PROJECT_ID=

# ── Cloudflare ─────────────────────────────────────────────────────────────

# Only needed if `wrangler` is not already authenticated interactively on this
# machine (`wrangler login`). An API token with Workers Scripts:Edit works.
CLOUDFLARE_API_TOKEN=
