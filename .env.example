# Secrets for the migration scripts. Copy to `.env` (gitignored) and fill in.
# Every non-secret value lives in project.jsonc instead.

# Webflow Site API token, CMS read scope — Site settings > Apps & integrations
# > API access. Used by `npm run wf:pull` to dump the collections verbatim.
WEBFLOW_API_TOKEN=

# Sanity token with write access to the project in project.jsonc —
# sanity.io/manage > API > Tokens. Used by `npm run sanity:import` and by
# `sanity deploy`.
SANITY_AUTH_TOKEN=
