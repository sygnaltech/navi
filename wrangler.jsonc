{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site-navi",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat"],

	// LOCAL ONLY — used by `npm run preview` (wrangler dev) to serve a built
	// site the way Cloudflare will. Nothing deploys from this file: `npm run
	// deploy` names wrangler.prod.jsonc explicitly.
	//
	// Mirrors production, including the ABSENCE of `not_found_handling` — see
	// the long note in wrangler.prod.jsonc. Differing here would mean the local
	// check answers a different 404 than the live site, which is exactly the
	// case you would use it on.
	"main": "./web/dist/server/entry.mjs",

	"assets": {
		"directory": "./web/dist/client",
		"binding": "ASSETS"
	},

	"kv_namespaces": [{"binding": "SESSION"}],
	"images": {"binding": "IMAGES"},

	"observability": {
		"enabled": true
	}
}
