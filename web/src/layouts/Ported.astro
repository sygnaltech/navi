---
/**
 * A ported Webflow page: frozen body, dataset-bound shell.
 *
 * A thin wrapper over `Shell.astro` that pulls this page's metadata out of the
 * extraction manifest. The collection routes call `Shell` directly with a body
 * they bound themselves; both paths emit the identical head and `<body>`
 * treatment, so the two kinds of page cannot drift apart.
 *
 * TITLES ARE ESCAPED EXACTLY ONCE. The manifest holds DECODED text, so Astro's
 * own escaping is the only escaping that happens. Storing the raw `<title>`
 * instead — already HTML-escaped — yields `&amp;amp;` and a literal `&amp;` in
 * the browser tab.
 */
import Shell from './Shell.astro';
import {bodyFor, headFor, pages} from '../lib/ported';
import type {Shell as ShellData} from '../lib/cms';

interface Props {
  slug: string;
  shell: ShellData;
}

const {slug, shell} = Astro.props;
const page = pages[slug];
---

<Shell
  lang={page.lang}
  wfPage={page.wfPage}
  bodyAttrs={page.bodyAttrs}
  title={page.title}
  description={page.description}
  ogTitle={page.ogTitle}
  ogDescription={page.ogDescription}
  head={headFor(slug)}
  body={bodyFor(slug)}
  shell={shell}
/>
