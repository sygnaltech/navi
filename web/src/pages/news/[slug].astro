---
/** `/news/<slug>` — 1 news post. */
import Shell from '../../layouts/Shell.astro';
import {bodyFor, headFor, pages} from '../../lib/ported';
import {getNews, getShell, imageUrl} from '../../lib/cms';
import {bindNews} from '../../lib/templates/listings';

export const prerender = false;

const {slug} = Astro.params;
if (!slug) return new Response(null, {status: 404});

const [news, shell] = await Promise.all([getNews(slug), getShell()]);
if (!news) return new Response(null, {status: 404});

const TEMPLATE = 'tpl-news';
const page = pages[TEMPLATE];
const body = bindNews(bodyFor(TEMPLATE), news);
---

<Shell
  lang={page.lang}
  wfPage={page.wfPage}
  bodyAttrs={page.bodyAttrs}
  title={page.title}
  description={news.summary}
  ogTitle={news.title}
  ogDescription={news.summary}
  ogImage={imageUrl(news.mainImage, 1200, 630)}
  head={headFor(TEMPLATE)}
  body={body}
  shell={shell}
/>
