---
import Shell from '../layouts/Shell.astro';
import {getShell} from '../lib/cms';
import {headFor} from '../lib/ported';

export const prerender = false;

Astro.response.status = 404;

const shell = await getShell();
const body = `
  <!--wf:nav-->
  <main class="hero-medium _404" data-ix="move-down-on-load">
    <div class="container">
      <div class="underline-box">
        <h1 class="heading-1 white">404 <br>Page Not Found</h1>
      </div>
      <a href="/" class="button-square-rounded top-border w-inline-block" data-ix="move-right-on-hover">
        <div class="button-text">visit home</div>
        <img src="/wf/assets/59f0db6e0aad1d0001094151_Arow.png" width="14" alt="" class="button-arrow">
      </a>
    </div>
  </main>
  <!--wf:footer-->
  <script src="/wf/js/jquery-3.5.1.min.dc5e7f18c8.js"></script>
  <script src="/wf/js/navi-tours.schunk.45a0a6650236d163.js"></script>
  <script src="/wf/js/navi-tours.970275a3.d42d78cb1921a92d.js"></script>
`;
---

<Shell
  lang="en"
  wfPage="59f0db6e0aad1d00010940e4"
  bodyAttrs={{}}
  title="404"
  head={headFor('404')}
  body={body}
  shell={shell}
/>
